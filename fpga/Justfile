set shell := ["bash", "-euc"]
set windows-shell := ["bash", "-euc"]

default:
    @just --list --justfile Justfile

# Run all FPGA suites, or select suites and --fifo libero.
test *args:
    python tests/run.py {{args}}

# Build with the native Hog workflow.
build:
    ./Hog/Do WORKFLOW tiny_probe -recreate
